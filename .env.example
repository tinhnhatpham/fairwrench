# Optional: Free-tier Gemini API key from https://aistudio.google.com/apikey
# Enables photo/PDF quote OCR + deep AI reasoning with gemini-4-hydrogen.
# Without this key, FairWrench still runs full NHTSA lookup + deterministic benchmark auditing on text quotes!
GEMINI_API_KEY=

# Optional: Zero-monthly-fee Checkout URLs (Polar.sh Starter Plan or Stripe Payment Links)
# Leave empty during local testing to use the built-in Demo Unlock button.
POLAR_CHECKOUT_URL_SINGLE=
POLAR_CHECKOUT_URL_PRO=

# Optional: Secret token used to verify paid return redirects (?unlock_key=...)
# Set your Polar/Stripe success redirect URL to: https://YOUR-DOMAIN/audit?unlocked=1&key=YOUR_SECRET
UNLOCK_REDIRECT_SECRET=fairwrench-demo-unlock

# Public site URL for sitemap.xml, Open Graph tags, and SEO canonical links
NEXT_PUBLIC_SITE_URL=https://fairwrench.vercel.app
